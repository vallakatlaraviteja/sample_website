# --- Core --------------------------------------------------------------
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# --- Database ----------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/terrapulse
# Set to "true" to disable DB (read-only, in-memory fallback for everything)
DISABLE_DB=false

# --- Sessions ----------------------------------------------------------
# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-32-bytes-of-randomness-or-the-app-will-refuse-to-sign-cookies

# --- GitHub OAuth (https://github.com/settings/developers) -------------
# Authorization callback URL: ${PUBLIC_URL}/api/auth/github/callback
# If unset, auth is disabled and writes are blocked except in dev mode.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins that get admin powers (moderation queue).
ADMIN_LOGINS=

# --- Email (Resend - free 3k/mo, https://resend.com) -------------------
# Without this, digests print to console instead of sending.
RESEND_API_KEY=
EMAIL_FROM=alerts@terrapulse.example

# --- Stripe (https://dashboard.stripe.com) -----------------------------
# Without these, paid tier is disabled (free tier still works).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price for the "Verified" tier ($5/mo recommended).
STRIPE_PRICE_VERIFIED=

# --- Frontend mode -----------------------------------------------------
# "ai" = AI launches niche (default), "all" = generic world+tech
APP_MODE=ai
