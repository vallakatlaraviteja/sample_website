{
  "name": "terrapulse",
  "version": "2.0.0",
  "description": "TerraPulse - real-time 3D Earth dashboard. AI Launches mode: live, geo-tagged map of new AI/ML repos with email alerts and verified pulses.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "vendor-textures": "node scripts/vendor-textures.js",
    "send-digests": "node scripts/send-digests.js",
    "postinstall": "node scripts/vendor-textures.js || true"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.4.0",
    "cookie": "^0.6.0",
    "stripe": "^16.10.0"
  }
}
